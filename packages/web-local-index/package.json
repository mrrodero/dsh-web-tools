{
  "name": "@deepseek-ai/dsh-web-local-index",
  "description": "Local corpus index (SQLite FTS5 + MiniLM embeddings) and local_search tool for the DeepSeek Harness web capability bundle",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrrodero/dsh-web-tools.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tests"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-util-values": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-web": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-web-fetch-http": "^0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "onnxruntime-node": "^1.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  }
}
