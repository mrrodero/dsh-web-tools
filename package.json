{
  "name": "@deepseek-ai/dsh-web-tools",
  "description": "Self-hosted web capability bundle for the DeepSeek Harness: SearXNG search, headless-browser fetch/render, bounded site crawling, and a local corpus index (SQLite FTS5 + MiniLM embeddings)",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrrodero/dsh-web-tools.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./web-search-searxng": {
      "types": "./lib/web-search-searxng/index.d.ts",
      "default": "./lib/web-search-searxng/index.js"
    },
    "./web-fetch-browser": {
      "types": "./lib/web-fetch-browser/index.d.ts",
      "default": "./lib/web-fetch-browser/index.js"
    },
    "./web-crawl": {
      "types": "./lib/web-crawl/index.d.ts",
      "default": "./lib/web-crawl/index.js"
    },
    "./web-local-index": {
      "types": "./lib/web-local-index/index.d.ts",
      "default": "./lib/web-local-index/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-launch-environment": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-util-values": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-web": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-web-fetch-http": "^0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "cheerio": "^1.0.0",
    "onnxruntime-node": "^1.19.0",
    "playwright": "^1.52.0",
    "turndown": "^7.2.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  }
}
